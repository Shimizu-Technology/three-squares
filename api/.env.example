# Three Squares API - Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# DATABASE (Required)
# =============================================================================
DATABASE_URL=postgresql://localhost/three_squares_development

# =============================================================================
# CORS - Frontend URL (Required)
# =============================================================================
FRONTEND_URL=http://localhost:5173

# =============================================================================
# CLERK - Authentication (Required)
# Get these from Clerk Dashboard: https://dashboard.clerk.com
# =============================================================================
CLERK_SECRET_KEY=sk_test_YOUR_KEY_HERE
CLERK_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE

# =============================================================================
# AWS S3 - Image Uploads (Required for product images)
# =============================================================================
AWS_ACCESS_KEY_ID=YOUR_KEY_HERE
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_HERE
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=three-squares

# =============================================================================
# STRIPE - Payments (Optional for local dev)
# =============================================================================
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_SECRET_HERE

# =============================================================================
# RESEND - Email (Optional for local dev)
# =============================================================================
RESEND_API_KEY=re_YOUR_KEY_HERE

# Payment identities/profiles are provisioned explicitly; missing credentials never simulate.
# Use a separate development/test/staging database for sandbox or simulated payments.
APP_DEPLOYMENT_ENV=development
PAYMENTS_SIMULATION_ENABLED=false
PAYMENTS_DEFAULT_PROVIDER=worldpay
WORLDPAY_MODE=simulated
WORLDPAY_CHECKOUT_PRESENTATION=hosted_fields
# Additional explicit dispatch gate. Leave false until assigned profiles and
# currency/fraud/recovery contracts have been verified. No automatic fallback.
WORLDPAY_TRANSPORT_ENABLED=false
WORLDPAY_EXPRESS_ACCOUNT_ID=
WORLDPAY_EXPRESS_ACCOUNT_TOKEN=
WORLDPAY_EXPRESS_ACCEPTOR_ID=
WORLDPAY_EXPRESS_APPLICATION_ID=
WORLDPAY_EXPRESS_APPLICATION_NAME=Three Squares
WORLDPAY_EXPRESS_APPLICATION_VERSION=
WORLDPAY_EXPRESS_TRANSACTION_URL=https://certtransaction.elementexpress.com/
WORLDPAY_EXPRESS_REPORTING_URL=https://certreporting.elementexpress.com/
WORLDPAY_EXPRESS_SERVICES_URL=https://certservices.elementexpress.com/
WORLDPAY_EXPRESS_HOSTED_BASE_URL=https://certtransaction.hostedpayments.com/
WORLDPAY_TRIPOS_ORIGIN=https://triposcert.vantiv.com
WORLDPAY_ONLINE_TERMINAL_ID=
WORLDPAY_ONLINE_LANE_NUMBER=
WORLDPAY_TERMINAL_PROFILE_KEY=
WORLDPAY_RETURN_URL=
PAYMENTS_BUSINESS_TIME_ZONE=Pacific/Guam
WORLDPAY_REPORTING_TIME_ZONE=
STRIPE_ACCOUNT_ID=
ACTIVE_JOB_QUEUE_ADAPTER=solid_queue

# Account for platform webhooks that omit event.account; must match verified identity.
STRIPE_WEBHOOK_ACCOUNT_ID=
# Restrict these keys to required payment/query/refund/Terminal permissions where possible.
# Production requires APP_MODE=production; prefer rk_live_/rk_test_ credentials.
