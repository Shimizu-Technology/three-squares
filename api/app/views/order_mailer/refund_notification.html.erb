<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      line-height: 1.6;
      color: #333333;
      margin: 0;
      padding: 0;
      background-color: #f5f5f5;
    }
    .email-wrapper {
      max-width: 600px;
      margin: 0 auto;
      background-color: #ffffff;
    }
    .header {
      background-color: #1E3A5F;
      padding: 30px 40px;
      text-align: center;
    }
    .header h1 {
      color: #ffffff;
      margin: 0;
      font-size: 28px;
      font-weight: 700;
      letter-spacing: 1px;
    }
    .header-accent {
      width: 100%;
      height: 4px;
      background: linear-gradient(90deg, #F5C518 0%, #4A7FB5 50%, #F5C518 100%);
    }
    .content {
      padding: 40px;
    }
    .content h2 {
      color: #4A7FB5;
      margin-top: 0;
      font-size: 22px;
    }
    .refund-details {
      background-color: #F0EDE8;
      border-left: 4px solid #4A7FB5;
      padding: 20px;
      margin: 24px 0;
      border-radius: 0 4px 4px 0;
    }
    .refund-details table {
      width: 100%;
      border-collapse: collapse;
    }
    .refund-details td {
      padding: 8px 0;
      vertical-align: top;
    }
    .refund-details td:first-child {
      color: #666666;
      width: 140px;
      font-weight: 500;
    }
    .refund-details td:last-child {
      color: #333333;
      font-weight: 600;
    }
    .refund-amount {
      font-size: 24px;
      color: #4A7FB5;
      font-weight: 700;
    }
    .notice {
      background-color: #FFF8E7;
      border: 1px solid #F5C518;
      padding: 16px 20px;
      border-radius: 4px;
      margin: 24px 0;
      font-size: 14px;
      color: #8B5E3C;
    }
    .notice strong {
      display: block;
      margin-bottom: 4px;
    }
    .footer {
      background-color: #F0EDE8;
      padding: 24px 40px;
      text-align: center;
      font-size: 13px;
      color: #666666;
      border-top: 1px solid #e9ecef;
    }
    .footer a {
      color: #4A7FB5;
      text-decoration: none;
    }
    .tagline {
      color: #D4A030;
      font-size: 12px;
      margin-top: 4px;
    }
  </style>
</head>
<body>
  <div class="email-wrapper">
    <div class="header">
      <h1>Three Squares</h1>
      <p class="tagline">Good Food, Good Mood, Good Service</p>
    </div>
    <div class="header-accent"></div>

    <div class="content">
      <h2>Refund Processed</h2>

      <p>Hi <%= @order.name || 'there' %>,</p>

      <p>We've processed a refund for your order. Here are the details:</p>

      <div class="refund-details">
        <table>
          <tr>
            <td>Order Number</td>
            <td>#<%= @order.order_number %></td>
          </tr>
          <tr>
            <td>Refund Amount</td>
            <td class="refund-amount"><%= @amount %></td>
          </tr>
          <% if @refund.reason.present? %>
          <tr>
            <td>Reason</td>
            <td><%= @refund.reason %></td>
          </tr>
          <% end %>
          <tr>
            <td>Refund Date</td>
            <td><%= @refund.created_at.strftime('%B %d, %Y') %></td>
          </tr>
        </table>
      </div>

      <div class="notice">
        <strong>&#128197; When will I see my refund?</strong>
        Please allow 5&ndash;10 business days for the refund to appear on your original payment method.
        Processing times may vary depending on your bank or card issuer.
      </div>

      <p>If you have any questions about this refund, please don't hesitate to reach out to us.</p>

      <p>Thank you for dining with Three Squares!</p>
    </div>

    <div class="footer">
      <p>&copy; <%= Date.today.year %> Three Squares / B&G Pacific LLC. All rights reserved.</p>
      <p>
        <a href="https://bgpacific.com">bgpacific.com</a> &bull;
        <a href="tel:+16716462652">(671) 646-2652</a>
      </p>
    </div>
  </div>
</body>
</html>
